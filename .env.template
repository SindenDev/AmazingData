# ── AmazingData SDK 凭证 ─────────────────────────────────────
AD_HOST=101.230.159.234
AD_PORT=8600
AD_USERNAME=CHANGE_ME
AD_PASSWORD=CHANGE_ME

# ── 数据输出路径 ─────────────────────────────────────────────
# 测试阶段（NAS 本机运行，写入 amazingdata 目录）：
OUTPUT_DIR=./data

# SDK 本地缓存目录（复权因子、历史代码表等接口需要）：
SDK_CACHE_DIR=./data/cache

# ── 日志 ─────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=./logs

# ── RustFS / S3 同步配置 ─────────────────────────────────────
RUSTFS_ENDPOINT=http://192.168.112.170:9000
RUSTFS_ACCESS_KEY=CHANGE_ME
RUSTFS_SECRET_KEY=CHANGE_ME
RUSTFS_BUCKET=amazingdata
# 是否在 fetch 后自动同步到 RustFS（true / false）
SYNC_ENABLED=true

# ── ClickHouse 同步配置 ─────────────────────────────────────────
# 配置后，`sync` 命令和自动同步会额外写入 ClickHouse 
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=AmazingData
CLICKHOUSE_INSERT_CHUNK_SIZE=50000

# ── 日志 ─────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=./logs
